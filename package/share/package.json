{
  "name": "@syscript/share",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -b",
    "auto-build": "watchexec --filter 'src/**' --clear -- pnpm build",
    "check": "tsc --noEmit && eslint src && prettier --check src",
    "format": "eslint src --fix && prettier --write src && pnpm check"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "exports": {
    ".": "./dist/share/src/index.js"
  },
  "sideEffects": false,
  "devDependencies": {
    "tsx": "^4.23.0"
  }
}
