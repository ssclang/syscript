{
  "name": "@syscript/compiler",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "ssc:clean": "pnpm dev clean",
    "ssc:test": "pnpm dev test/fixture/main.ts --run",
    "build": "rm -rf dist/ && pnpm check && rolldown --config",
    "dev": "tsc --noEmit && tsx src/main.ts",
    "dev:watch": "watchexec -rc -- 'tsc --noEmit && tsx src/main.ts'",
    "start": "node --enable-source-maps dist/main.js",
    "start:build": "pnpm build && node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:cov": "vitest run --coverage",
    "test:cov:watch": "vitest watch --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "check": "tsc --noEmit && eslint *.ts src test && prettier --check *.ts src test",
    "format": "eslint *.ts src test --fix && prettier --write *.ts src test && pnpm check"
  },
  "dependencies": {
    "@syscript/share": "workspace:^",
    "@syscript/cli": "workspace:^",
    "bignumber.js": "^11.1.5",
    "zod": "catalog:"
  }
}
